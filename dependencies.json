{
  "schema_version": 1,
  "dependencies": [
    {
      "id": "uv",
      "name": "uv container image",
      "pins": [
        {
          "file": "Dockerfile",
          "pattern": "^FROM ghcr\\.io/astral-sh/uv:(?P<version>[^ ]+) AS uv$"
        }
      ],
      "source": {
        "type": "json",
        "url": "https://api.github.com/repos/astral-sh/uv/releases/latest",
        "path": ["tag_name"],
        "release_url": "https://github.com/astral-sh/uv/releases/latest"
      }
    },
    {
      "id": "node",
      "name": "Node.js LTS base image",
      "pins": [
        {
          "file": "Dockerfile",
          "pattern": "^FROM node:(?P<version>[0-9]+)-bookworm-slim$"
        }
      ],
      "source": {
        "type": "node_latest_lts",
        "url": "https://nodejs.org/dist/index.json",
        "release_url": "https://nodejs.org/en/about/previous-releases"
      },
      "comparison": "major"
    },
    {
      "id": "hyperframes",
      "name": "HyperFrames",
      "pins": [
        {
          "file": "Dockerfile",
          "pattern": "^ARG HYPERFRAMES_VERSION=(?P<version>.+)$"
        }
      ],
      "source": {
        "type": "json",
        "url": "https://registry.npmjs.org/hyperframes/latest",
        "path": ["version"],
        "release_url": "https://www.npmjs.com/package/hyperframes"
      }
    },
    {
